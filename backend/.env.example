# ==========================================
# 1. SERVER CONFIGURATION
# ==========================================
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ==========================================
# 2. MYSQL 8.0+ DATABASE CONFIGURATION
# ==========================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=flashcard_srs_db

# ==========================================
# 3. AUTHENTICATION (JWT & GOOGLE OAUTH)
# ==========================================
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# ==========================================
# 4. EDGE-TTS DEFAULT VOICES
# ==========================================
TTS_VOICE_EN_US=en-US-AriaNeural
TTS_VOICE_EN_UK=en-GB-SoniaNeural
TTS_VOICE_ZH_CN=zh-CN-XiaoxiaoNeural

